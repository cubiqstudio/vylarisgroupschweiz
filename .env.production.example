# =============================================================================
# VylarisGroup Schweiz – Produktionsvorlage für docker-compose.yml
#
# Verwendung:   cp .env.production.example .env   und Werte anpassen.
# Die Datei .env ist per .gitignore ausgeschlossen – niemals committen.
# Alle Werte hier sind Platzhalter, keine echten Geheimnisse.
# =============================================================================

# --- Pflicht -----------------------------------------------------------------
# Signiert die Sitzungen (Admins und Website-Nutzer) und verschlüsselt das im Admin hinterlegte
# SMTP-Passwort in der Datenbank. Mindestens 32 Zeichen. Erzeugen: openssl rand -base64 48
# Nach Änderung muss das SMTP-Passwort im Admin neu eingegeben werden.
AUTH_SECRET=

# Passwort des PostgreSQL-Benutzers. Erzeugen: openssl rand -hex 24
# (Hex-Werte enthalten keine Sonderzeichen und sind in der Verbindungs-URL unproblematisch.)
POSTGRES_PASSWORD=

# Start-Passwort des Admin-Kontos (wird vom Seed gesetzt). Nach dem ersten Login ändern.
# Nicht das Beispielpasswort aus der Entwicklungsumgebung verwenden.
ADMIN_PASSWORD=

# --- Datenbank (optional, Defaults siehe docker-compose.yml) ------------------
POSTGRES_USER=vylaris
POSTGRES_DB=vylaris_schweiz

# --- Admin-Konto --------------------------------------------------------------
ADMIN_EMAIL=admin@vylaris.example

# --- Seed ---------------------------------------------------------------------
# true  = beim Containerstart Admin-Konto und Basisinhalte anlegen. Die Basisinhalte
#         (Beispieldienste, Texte usw.) legt der Seed nur beim ersten Start an; Änderungen aus dem
#         Admin-Bereich werden nie überschrieben.
# false = Seed abschalten.
SEED_ON_START=true
# Basis-Domain der beispielhaften SaaS-Dienste im Seed (z. B. vault.<domain>), wirkt nur beim
# ersten Start. Die Beispieldienste sind im Admin durch die echten Angebote zu ersetzen.
SEED_BASE_DOMAIN=vylaris.example

# --- Website ------------------------------------------------------------------
# Öffentliche URL der Seite (mit https://, ohne abschliessenden Slash)
SITE_URL=https://vylaris.ch
# Login-Cookie nur über HTTPS. "false" ausschließlich für lokale HTTP-Tests!
COOKIE_SECURE=true

# --- Netzwerk -----------------------------------------------------------------
# Host-Port der App.
APP_PORT=3000
# 127.0.0.1 = nur lokal (empfohlen hinter Reverse Proxy), 0.0.0.0 = von außen erreichbar
APP_BIND=127.0.0.1
# Woher die App die Client-IP für Rate-Limits nimmt:
#   cloudflare = Header CF-Connecting-IP (Tunnel-Betrieb; docker-compose.cloudflare.yml setzt das selbst)
#   caddy / leer = Header X-Forwarded-For (Caddy oder Direktbetrieb hinter einem Proxy, der den Header
#                  selbst setzt; docker-compose.https.yml setzt "caddy")
# In der Regel nichts eintragen: die Overlay-Dateien wählen den passenden Wert.
# TRUST_PROXY=

# --- Rechtliche Angaben für Impressum/Datenschutz (vor Go-Live ausfüllen!) ---
# Diese Werte sind nur ANFANGSWERTE (Fallback). Was im Admin unter Einstellungen → Rechtliches
# gespeichert wird, hat Vorrang; leere Admin-Felder fallen auf diese Werte zurück.
# install.sh fragt sie ab und trägt sie hier ein. Keine Anführungszeichen, $ oder # verwenden.
# Vorbelegt mit den öffentlich bekannten Angaben des Vereins.
# Öffentliche Kontakt-Mailadresse (Impressum/Datenschutz)
CONTACT_EMAIL=support@vylaris.ch
LEGAL_STREET=Schützengasse 13
LEGAL_ZIP_CITY=9410 Heiden (AR)
LEGAL_COUNTRY=Schweiz
LEGAL_PHONE=+41 78 322 21 39
# Registereintrag, falls vorhanden
LEGAL_REGISTER=
# MWST-/UID-Nummer, falls vorhanden
LEGAL_VAT_ID=

# --- HTTPS (docker-compose.https.yml: Caddy + Let's Encrypt; install.sh füllt das aus) ---
# Domain, deren A-Record (und der von www.<Domain>) auf diesen Server zeigt (ohne https:// und ohne www)
DOMAIN=vylaris.ch
# E-Mail für Let's-Encrypt-Hinweise (Zertifikat-Ablauf)
ACME_EMAIL=
# Zum Testen ohne Rate-Limits: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Beide Dateien zusammen verwenden, damit "docker compose …" ohne -f funktioniert:
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# --- Cloudflare Tunnel (docker-compose.cloudflare.yml statt Caddy; install.sh / scripts/cloudflare-setup.sh füllen das aus) ---
# vylaris.ch und www.vylaris.ch über einen Tunnel, kein offener Port nötig. Der Tunnel-Token wird von
# scripts/cloudflare-setup.sh angelegt und hier eingetragen (Geheimnis, nicht committen). Der Cloudflare-API-Token
# selbst wird NICHT gespeichert.
# CLOUDFLARE_TUNNEL_TOKEN=
# Im Tunnel-Modus statt der Caddy-Zeile oben verwenden:
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloudflare.yml

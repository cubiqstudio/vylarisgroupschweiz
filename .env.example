# --- Datenbank ---
# Lokale Entwicklung (SQLite):
DATABASE_URL="file:./dev.db"
# Produktion (PostgreSQL), siehe docker-compose.yml:
# DATABASE_URL="postgresql://vylaris:CHANGE_ME@db:5432/vylaris_schweiz?schema=public"

# --- Authentifizierung ---
# Mindestens 32 Zeichen. Erzeugen: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"
# Optional: eigenes Geheimnis (mind. 32 Zeichen) für Lizenzschlüssel; sonst gilt AUTH_SECRET.
# Ein Wechsel macht bestehende Lizenzschlüssel ungültig.
# LICENSE_SECRET=""
# "false" nur setzen, wenn die Seite ohne HTTPS betrieben wird (z.B. lokaler Docker-Test)
# COOKIE_SECURE="false"

# --- Seed (nur beim Befüllen der DB) ---
ADMIN_EMAIL="admin@vylaris.example"
ADMIN_PASSWORD="ChangeMe-Vylaris-2026!"

# --- Website ---
SITE_URL="http://localhost:3000"

# --- Rechtliche Angaben für Impressum/Datenschutz (vor Go-Live ausfüllen!) ---
# Diese Werte sind nur ANFANGSWERTE (Fallback). Was im Admin unter Einstellungen → Rechtliches
# gespeichert wird, hat Vorrang. Der Server-Installer (install.sh) fragt sie ab und trägt sie ein.
# Ohne Angabe legt der Seed die öffentlich bekannten Angaben des Vereins als Einstellungen an.
# CONTACT_EMAIL="support@vylaris.ch"     # öffentliche Kontakt-Mailadresse
# LEGAL_STREET="Schützengasse 13"
# LEGAL_ZIP_CITY="9410 Heiden (AR)"
# LEGAL_COUNTRY="Schweiz"
# LEGAL_PHONE="+41 78 322 21 39"
# LEGAL_REGISTER=""     # Registereintrag, falls vorhanden
# LEGAL_VAT_ID=""       # MWST-/UID-Nummer, falls vorhanden

# --- Cloudflare Tunnel (nur Server-Betrieb, siehe .env.production.example und README) ---
# Wird von install.sh bzw. scripts/cloudflare-setup.sh gesetzt; für die lokale Entwicklung nicht nötig.
# CLOUDFLARE_TUNNEL_TOKEN=
